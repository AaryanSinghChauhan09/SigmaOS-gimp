#!/usr/bin/env bash
# sigmaos-gimp — SigmaOS helper for gimp.
set -euo pipefail
APP="gimp"
cmd="${1:-status}"
case "$cmd" in
  launch)  xdg-open "$(command -v $APP || command -v ${APP}bin || echo /usr/bin/$APP)" 2>/dev/null || echo "$APP not installed";;
  config)  echo "config dir: $HOME/.config/GIMP"; ls "$HOME/.config/GIMP" 2>/dev/null | head;;
  reset)   echo "remove $HOME/.config/GIMP to reset $APP";;
  *) echo "usage: sigmaos-gimp launch|config|reset" >&2; exit 2;;
esac
